# Gemini API key for AI content generation
GEMINI_API_KEY=your-gemini-api-key-here

# Bearer token for API authentication (clients send this in Authorization header)
API_TOKEN=a-long-random-secret-token-here

# Comma-separated list of allowed CORS origins (no spaces around commas)
CORS_ORIGINS=http://localhost:3000

# Rate limits (requests per day)
FREE_LIMIT=5
PRO_LIMIT=50
